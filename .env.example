# ==============================================================================
# ALINEVA WEBSITE - CONFIGURACIÓN DE VARIABLES DE ENTORNO (PLANTILLA SEGURA)
# Protocolo: SR-ALINEVA-WHATSAPP-06H
# NOTA DE SEGURIDAD: Nunca incluir claves reales, tokens de muestra ni secretos
# en este archivo ni versionarlos en el repositorio Git.
# ==============================================================================

# HubSpot CRM - Credenciales de Integración
# Token privado de aplicación de HubSpot (Private App Access Token)
HUBSPOT_ACCESS_TOKEN=

# Portal / Account ID de HubSpot (Alineva: 248017141)
HUBSPOT_PORTAL_ID=248017141

# URL base de la API de HubSpot (Controlada en servidor)
HUBSPOT_API_URL=https://api.hubapi.com

# Versión oficial de la API de Contacts (Versión fechada oficial preferente)
HUBSPOT_CONTACTS_API_VERSION=2026-09

# Tiempo límite de espera para llamadas al CRM (en milisegundos)
HUBSPOT_TIMEOUT_MS=8000

# Nombres internos de propiedades personalizadas de HubSpot
# (Los valores reales deberán confirmarse en HubSpot antes de producción)
HUBSPOT_PROPERTY_FULL_NAME=
HUBSPOT_PROPERTY_MESSAGE=
HUBSPOT_PROPERTY_INTEREST=
HUBSPOT_PROPERTY_PRIVACY_CONSENT=

# Fecha de consentimiento (Tipo en HubSpot: Date picker, solo YYYY-MM-DD sin hora)
HUBSPOT_PROPERTY_CONSENT_DATE=

# Fecha y hora de consentimiento (Tipo en HubSpot: Date and time picker)
# Propiedad adicional para trazabilidad UTC exacta.
# MASTER ARB creará posteriormente la propiedad en HubSpot y confirmará el nombre interno.
# Nombre propuesto: alineva_fecha_hora_consentimiento
HUBSPOT_PROPERTY_CONSENT_TIMESTAMP=

HUBSPOT_PROPERTY_PRIVACY_VERSION=
HUBSPOT_PROPERTY_PRIVACY_HASH=
HUBSPOT_PROPERTY_SOURCE_CHANNEL=

# Nombre interno de la propiedad de WhatsApp en HubSpot (predeterminado: hs_whatsapp_phone_number)
HUBSPOT_PROPERTY_WHATSAPP_PHONE=

# Propietario por defecto para nuevos contactos (HubSpot Owner)
# En Protocolo 06H, los prospectos nuevos se registran inicialmente sin propietario.
# La asignación posterior es una operación administrativa dentro de HubSpot CRM.
HUBSPOT_DEFAULT_OWNER_EMAIL=

# Nombre interno de la propiedad de propietario en HubSpot (predeterminado: hubspot_owner_id)
HUBSPOT_PROPERTY_OWNER_ID=

# Notificaciones Operativas Desacopladas de Nuevos Prospectos (Resend API)
# Clave de API de Resend (servidor)
RESEND_API_KEY=

# Destinatario de la alerta operativa de nuevos prospectos (ej. notificaciones@example.com)
ALINEVA_LEAD_NOTIFICATION_EMAIL=

# Remitente de la notificación (ej. Alineva CRM <notificaciones@example.com>)
ALINEVA_LEAD_NOTIFICATION_FROM=

# Dirección para respuestas opcional (ej. soporte@example.com)
ALINEVA_LEAD_NOTIFICATION_REPLY_TO=
